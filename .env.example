COMPOSE_PROJECT_NAME=complaints_mis

# Database
POSTGRES_USER=complaints
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=complaints_db

# Backend
DATABASE_URL=postgresql+asyncpg://complaints:your_postgres_password_here@db:5432/complaints_db
SYNC_DATABASE_URL=postgresql+psycopg2://complaints:your_postgres_password_here@db:5432/complaints_db
SECRET_KEY=your_64_char_hex_secret_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_ENV=development
APP_VERSION=0.1.0
CORS_ORIGINS=http://localhost:3000

# AI / RAG
AI_ENABLED=false
LLM_PROVIDER=openai
EMBEDDINGS_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
EMBEDDINGS_MODEL=text-embedding-3-small
RAG_SIM_THRESHOLD=0.50
RAG_TOP_K=6
OPENAI_API_KEY=your_key_here
# OLLAMA_BASE_URL=http://ollama:11434

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
