COMPOSE_PROJECT_NAME=waseet_prod

# Database: keep this strong; Postgres is private inside Docker in production.
POSTGRES_USER=waseet
POSTGRES_PASSWORD=your_strong_db_password_here
POSTGRES_DB=waseet_db

# Backend
APP_ENV=production
APP_VERSION=0.1.0
WEB_CONCURRENCY=2
SECRET_KEY=your_64_char_hex_secret_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=https://waseetproject.com,https://www.waseetproject.com

# Frontend: use /api when frontend and backend are served from the same domain by nginx.
NEXT_PUBLIC_API_URL=/api

# AI / Knowledge Base
AI_ENABLED=false
KB_PROVIDER=openai
KB_LOCAL_INDEXING_ENABLED=false
OPENAI_API_KEY=your_key_here
OPENAI_VECTOR_STORE_ID=
OPENAI_ASSISTANT_ID=
LLM_PROVIDER=openai
EMBEDDINGS_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
EMBEDDINGS_MODEL=text-embedding-3-small
RAG_SIM_THRESHOLD=0.50
RAG_TOP_K=6
